      ArcaneOnyx.BehaviorTree, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null]]"},"position":{"x":0.0,"y":0.0},"defaultValues":{},"LastExecutionStatus":"None","runtimeException":null,"positionRect":{"xMin":-4308.0,"yMin":540.0,"xMax":-4158.0,"yMax":628.0},"guid":"597922de-ffe8-470b-b952-988342769166","$type":"ArcaneOnyx.BehaviorTree.VisualScriptGraphVariable","$id":"97"},{"$ref":"31"},{"ScriptGraphVariable":{"returnType":"System.Object,
